# Keep model weights, generated media, local caches, and credentials out of every
# Docker build context.  The runtime image never needs them and sending them to
# the daemon makes an otherwise small image rebuild unexpectedly enormous.
.git/
.gitignore
models/
outputs/
cache/
results/
inputs/
.env
.env.*
*.pem
*.key
id_rsa*
.ssh/
**/.ssh/
authorized_keys
known_hosts
id_ed25519*
id_ecdsa*
id_dsa*
**/.env
**/.env.*
.netrc
.npmrc
.pypirc
.docker/config.json
**/.netrc
**/.npmrc
**/.pypirc
**/.docker/config.json
**/*.pem
**/*.key
**/authorized_keys
**/known_hosts
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/id_dsa*
*.safetensors
*.gguf
*.pth
*.pt
*.ckpt
**/*.safetensors
**/*.gguf
**/*.pth
**/*.pt
**/*.ckpt
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
